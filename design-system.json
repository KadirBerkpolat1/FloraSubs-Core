      "body": ["Inter", "system-ui", "sans-serif"],
      "mono": ["JetBrains Mono", "Fira Code", "monospace"]
    },
    "fontSizes": {
      "display-lg": "1.5rem",
      "display-md": "1.25rem",
      "display-sm": "1rem",
      "headline": "0.875rem",
      "body-lg": "0.875rem",
      "body-md": "0.8125rem",
      "body-sm": "0.75rem",
      "caption": "0.6875rem",
      "mono-xs": "0.625rem",
      "mono-sm": "0.6875rem",
      "mono-md": "0.8125rem"
    },
    "fontWeights": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeights": {
      "tight": 1.2,
      "snug": 1.3,
      "normal": 1.4,
      "relaxed": 1.5,
      "loose": 1.6
    },
    "letterSpacing": {
      "tight": "-0.02em",
      "normal": "0",
      "wide": "0.05em",
      "wider": "0.1em"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.25rem",
    "6": "1.5rem",
    "8": "2rem",
    "10": "2.5rem",
    "12": "3rem"
  },
  "borderRadius": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1.5rem",
    "full": "9999px"
  },
  "shadows": {
    "sm": "0 1px 2px rgba(0,0,0,0.3)",
    "md": "0 4px 12px rgba(0,0,0,0.4)",
    "lg": "0 8px 24px rgba(0,0,0,0.5)",
    "xl": "0 16px 48px rgba(0,0,0,0.6)",
    "glow-blue": "0 0 20px rgba(59,130,246,0.3)",
    "glow-purple": "0 0 20px rgba(168,85,247,0.3)",
    "glow-emerald": "0 0 20px rgba(16,185,129,0.3)"
  },
  "animations": {
    "durations": {
      "fast": "100ms",
      "normal": "200ms",
      "slow": "300ms",
      "spring": "350ms"
    },
    "easings": {
      "ease-out": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "ease-in-out": "cubic-bezier(0.42, 0, 0.58, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  },
  "breakpoints": {
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "2xl": "1536px"
  },
  "components": {
    "button": {
      "variants": ["primary", "secondary", "ghost", "danger", "success", "outline"],
      "sizes": ["sm", "md", "lg"]
    },
    "input": {
      "variants": ["default", "search", "mono"],
      "sizes": ["sm", "md", "lg"]
    },
    "select": {
      "variants": ["default"],
      "sizes": ["sm", "md", "lg"]
    },
    "card": {
      "variants": ["default", "elevated", "interactive", "featured"]
    },
    "badge": {
      "variants": ["default", "primary", "success", "warning", "error", "processing"],
      "sizes": ["sm", "md"]
    },
    "progress": {
      "sizes": ["sm", "md", "lg"],
      "variants": ["primary", "success", "warning", "error", "indeterminate"]
    },
    "modal": {
      "sizes": ["sm", "md", "lg", "xl", "full"]
    }
  }
}